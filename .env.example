# Copy to .env for local development. Never commit .env (this repo is public).

# The key that opens secrets.sealed (database URI and admin login).
# Create one with:  npx tsx scripts/seal-secrets.ts --generate-key
# Put the SAME value in your host's environment (e.g. Render → Environment) and keep a copy somewhere safe.
APP_SECRET_KEY=

# Optional overrides — any value set here or on the host wins over secrets.sealed.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=elysian
# ADMIN_USERNAME=administer
# ADMIN_PASSWORD=
# ADMIN_PIN=off          # 6 digits adds a PIN step at admin sign-in; "off" for username + password

# Public address of the site (used in emails). e.g. https://yoursite.com
APP_URL=

# Email for password reset codes — set ONE option.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# or
RESEND_API_KEY=
# or
SENDGRID_API_KEY=
EMAIL_FROM="Elysian <no-reply@yourdomain.com>"

# Proxies in front of the app (Render = 1), so rate limits use the real visitor IP.
TRUST_PROXY_HOPS=1
