# Copy to .env and fill in. Never commit .env.
# MongoDB connection string (leave blank to use local data.json + ./uploads fallback)
MONGODB_URI=

# --- Admin account (server-side only; do NOT prefix with VITE_) ---
# Applied on every server start, so changing these + restarting rotates the admin login.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_PIN=123456

# Optional: shared secret for scripted admin API calls via the X-Admin-Key header
ADMIN_KEY=

# Optional: Gemini auto-tagging
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional: email provider for password resets (otherwise links are logged to the console)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=
APP_URL=
