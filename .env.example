# Copy to .env and fill in. Never commit .env (this repo is public).

# MongoDB Atlas connection string. Paste your password WITHOUT the < > brackets
# (the server strips them if you forget). Leave blank to use a local data.json file (development only).
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=elysian

# --- Admin account ---
# Applied every time the server starts: changing these and restarting updates the admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-passphrase-here
ADMIN_EMAIL=you@example.com
# A 6-digit PIN adds a second step at admin sign-in. Use "off" for username + password only.
ADMIN_PIN=off

# Public address of the site (used in emails and the sitemap), e.g. https://yoursite.com
APP_URL=

# --- Email (password reset codes) — set ONE option ---
# SMTP (Gmail needs an App Password: Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# …or an email API
RESEND_API_KEY=
SENDGRID_API_KEY=
# Sender shown on emails
EMAIL_FROM="Elysian <no-reply@yourdomain.com>"

# Number of proxies in front of the app (Render = 1). Used to rate-limit by the real visitor IP.
TRUST_PROXY_HOPS=1
