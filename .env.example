# Copy to .env and fill in. Never commit .env.

# MongoDB connection string. Leave blank to use a local data.json file (development only).
MONGODB_URI=
# Database name (the previous site used "elysian")
MONGODB_DB=elysian

# --- Admin account (server-side only) ---
# Applied every time the server starts, so changing these and restarting rotates the admin login.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_PIN=123456

# Public address of the site, used in password-reset emails and the sitemap (e.g. https://yoursite.com)
APP_URL=

# Email for password resets (pick one). Without one, reset links are only printed in the server log.
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=

# Number of proxies in front of the app (Render = 1). Used to rate-limit by the real visitor IP.
TRUST_PROXY_HOPS=1
